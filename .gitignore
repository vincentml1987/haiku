# Daemon runtime data — local state, not source
daemon/*.db
daemon/*.db-journal
daemon/*.db-wal
daemon/*.db-shm
daemon/*.admin_secret
daemon/*.backup-before-migration-*
daemon/*.backup-before-restart-*
# Attachment stores: participants' files, never source
daemon/attachments/
daemon/*.attachments/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node (if plugin tooling ends up JS/TS)
node_modules/

# Plugin types/tsconfig the engine writes on each load — regenerated, not source
plugin/.claude-plugin/types/
plugin/tsconfig.json

# Editor/OS cruft
.DS_Store
Thumbs.db
daemon/*.log
usage-data/
